# 可选环境变量示例。复制为 .env 后按需填写（.env 已在 .gitignore 中）。

# 0302 REST 包装：上游天气 API 地址
WEATHER_API=http://127.0.0.1:8107

# 0305 部署：应用版本（fastmcp.json 里也有默认值）
APP_VERSION=1.0.0

# 0204 鉴权：Bearer token（静态 token 仅用于学习，生产请用 JWT/OAuth）
MCP_AUTH_TOKEN=alice-token

# FastMCP 客户端 OAuth 缓存加密（可选）
# FASTMCP_OAUTH_ENCRYPTION_KEY=
